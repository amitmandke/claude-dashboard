{
  "name": "claude-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Local dashboard to observe and interact with all Claude Code sessions on this machine",
  "license": "MIT",
  "author": "Amit Mandke <amitmandke@gmail.com> (https://github.com/amitmandke)",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "start": "node server/src/index.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-coverage-exclude=test/** --test-coverage-exclude=server/src/routes/** --test-coverage-exclude=server/src/services/sessionRegistry.js --test-coverage-exclude=server/src/services/projects.js --test-coverage-exclude=server/src/services/skills.js --test-coverage-exclude=server/src/services/terminals/** --test-coverage-exclude=server/src/services/watchers/slack.js --test-coverage-exclude=server/src/services/watchers/gh.js --test-coverage-lines=80 --test-coverage-branches=68 --test-coverage-functions=78"
  },
  "engines": {
    "node": ">=18"
  }
}
